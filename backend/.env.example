# Copy to .env. Leave DATABASE_URL empty to use embedded Postgres.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DBNAME?sslmode=disable
JWT_SECRET=salem-book-house-dev-secret-change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Live UPI/cards (optional). Without these, online pay is simulated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (optional). Without SMTP, messages go to admin Email outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=care@salembookhouse.com

# MR Rokesh ERP (MCP). Key from ERP → Administration → Claude AI (MCP).
ERP_MCP_URL=https://muruga-api-bjmm.onrender.com/mcp
ERP_API_KEY=
# Minutes between automatic ERP product syncs (0 = manual only).
ERP_SYNC_MINUTES=15
