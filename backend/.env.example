# Copy to .env. Leave DATABASE_URL empty to use embedded Postgres.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DBNAME?sslmode=disable
JWT_SECRET=salem-book-house-dev-secret-change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://ecommerce-book-one.vercel.app

# Live UPI/cards (optional). Without these, online pay is simulated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (optional). Without SMTP, messages go to admin Email outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=care@salembookhouse.com

# SMS (MSG91). Optional — order updates also go to email/outbox.
MSG91_AUTH_KEY=
MSG91_SENDER=SBHOM

# MR Rokesh ERP store API. Key is sent as X-Api-Key (mrerp_...).
ERP_API_URL=https://muruga-api-bjmm.onrender.com
ERP_API_KEY=
ERP_SYNC_MINUTES=15

# Multi-carrier shipping (configure in Admin → Shipping partners, or via env).
# Default partner is chosen in admin; credentials can also live in DB.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=636001

SHADOWFAX_TOKEN=
SHADOWFAX_CLIENT_CODE=

BLUEDART_LOGIN_ID=
BLUEDART_LICENSE_KEY=
BLUEDART_API_TYPE=S
BLUEDART_CUSTOMER_CODE=
BLUEDART_ENDPOINT=

DELHIVERY_TOKEN=
DELHIVERY_PICKUP_NAME=Salem Book House

DTDC_API_KEY=
DTDC_CUSTOMER_CODE=
DTDC_ENDPOINT=

# Shared secret for POST /api/shipping/webhooks/:carrier?secret=
SHIPPING_WEBHOOK_SECRET=

# GST invoice (HTML printable as PDF)
GSTIN=
BUSINESS_NAME=Salem Book House
BUSINESS_ADDRESS=Salem, Tamil Nadu, India
DEFAULT_HSN=4901
GST_RATE=0
